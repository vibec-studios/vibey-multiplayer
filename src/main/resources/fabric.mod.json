{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "Host your singleplayer world for friends anywhere: one fixed address, no port forwarding.",
  "authors": ["Vibe Craft Studios"],
  "contact": {
    "homepage": "https://vibec-studios.github.io/mods/vibey-multiplayer/",
    "sources": "https://github.com/vibec-studios/vibey-multiplayer",
    "issues": "https://github.com/vibec-studios/vibey-multiplayer/issues"
  },
  "license": "MIT",
  "icon": "assets/vibey/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.henny.vibey.fabric.VibeyFabricClient"]
  },
  "depends": {
    "fabricloader": ">=0.16.5",
    "fabric-api": "*",
    "minecraft": "${minecraft_range}",
    "java": ">=${java}"
  }
}
